{
  "name": "codelearn",
  "productName": "CodeLearn",
  "version": "0.2.0",
  "description": "以 Problem 为核心的个人学习与复习系统",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.cjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/launch.cjs electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win"
  },
  "author": "CodeLearn",
  "license": "MIT",
  "overrides": {
    "@noble/hashes": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
